# Local development database (PostgreSQL 17 + PostGIS on port 5433)
DATABASE_URL=postgresql://localhost:5433/exactpoint_dev

# Scratch database used by integration tests (dropped and recreated by the test suite)
TEST_DATABASE_URL=postgresql://localhost:5433/exactpoint_test

# Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dev-only seed password for the owner account (never used in production)
SEED_OWNER_PASSWORD=
