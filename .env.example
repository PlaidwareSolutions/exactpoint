# Local development database (PostgreSQL 17 + PostGIS on port 5433)
DATABASE_URL=postgresql://localhost:5433/exactpoint_dev

# Scratch database used by integration tests (dropped and recreated by the test suite)
TEST_DATABASE_URL=postgresql://localhost:5433/exactpoint_test

# Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dev-only seed password for the owner account (never used in production)
SEED_OWNER_PASSWORD=

# Infrastructure (owner-supplied; never committed)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
RAILWAY_WORKSPACE_TOKEN=

# Google Maps Platform (server key: Address Validation + Routes; browser key:
# Maps JavaScript, referrer-restricted)
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Cloudflare R2 (durable media storage; local disk fallback when unset)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# Plaidware Marketing Ops Hub (funnel events; integration is a no-op when the
# key is unset). Key format mhk_… from Plaidware ops.
MHUB_BASE_URL=https://mhub-web-staging.up.railway.app/api/v1
MHUB_EVENTS_KEY=

# Resend transactional email (worker sends when both are set; console-only otherwise)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Resend webhook signing secret (web service): delivery events behind the
# Manager's Delivered / Bounced status. Resend → Webhooks → Add endpoint
# https://<host>/api/webhooks/resend with the email.* delivery events.
RESEND_WEBHOOK_SECRET=
